# Copie para .env e ajuste. Nunca commite secrets reais.

DB_URL=jdbc:postgresql://localhost:5432/bybusca
DB_USER=bybusca
DB_PASSWORD=bybusca

JWT_SECRET=change-me-bybusca-dev-secret-key-32b-min
BYBUSCA_DEFAULT_TENANT=demo-escola

# Google Programmable Search
# CX público do engine (widget + API). API_KEY só no backend se usar JSON API.
GOOGLE_PSE_ENABLED=false
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=e54b7047fc7e64e10
GOOGLE_PSE_TIMEOUT_MS=2500

# Google Cloud Vision (busca por foto)
GOOGLE_VISION_ENABLED=false
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_TIMEOUT_MS=4000
GOOGLE_VISION_MAX_UPLOAD_BYTES=5242880

# Frontend (apps/web)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_TENANT=demo-escola
VITE_GOOGLE_PSE_CX=e54b7047fc7e64e10

# Produção VPS (docker-compose.prod.yml)
POSTGRES_DB=bybusca
BYBUSCA_CORS_ORIGINS=http://bybusca.alenxandriaglobaltec.com,https://bybusca.alenxandriaglobaltec.com
# Em produção o front usa /api/v1 (mesmo domínio, via Nginx).

# Usuários seed (somente desenvolvimento)
# admin / prof / aluno — senha: senha123
